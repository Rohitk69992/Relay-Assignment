# The Relay Configuration Template
# Copy this file to .env and configure your variables. Do NOT commit .env to version control.

# Groq API Configuration
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Provider Mode: "groq" for real API, "standin" for controlled simulation
PROVIDER_MODE=standin

# Rate Limiting & Concurrency Safety Limits
RATE_LIMIT_RPM=30
RATE_LIMIT_TPM=8000
RATE_LIMIT_RPD=14400
RATE_LIMIT_TPD=500000
MAX_CONCURRENT_REQUESTS=5
MAX_QUEUE_SIZE=50
QUEUE_TIMEOUT_SECONDS=10.0
REQUEST_TIMEOUT_SECONDS=30.0

# Retry Policy
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=5.0
RETRY_JITTER=0.2

# Retrieval Defaults
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=4
DEFAULT_RERANK_ENABLED=true

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOG_LEVEL=INFO
